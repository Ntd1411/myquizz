@baseUrl = http://localhost:3000
@email = test@example.com
@password = Test123456
@fullname = Test User
@phone = 0123456789

### 1. Register user mới
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "fullname": "{{fullname}}",
  "phone": "{{phone}}"
}

### 2. Login để lấy accessToken
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### 3. Get me
GET {{baseUrl}}/users/me
Authorization: Bearer {{login.response.body.accessToken}}

### 4. Change password
PATCH {{baseUrl}}/users/password
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "oldPassword": "{{password}}",
  "newPassword": "NewPassword123456"
}

### 5. Try login với password cũ (phải fail)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### 6. Login với password mới
# @name login_new
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "NewPassword123456"
}

### 7. Test error: oldPassword sai
PATCH {{baseUrl}}/users/password
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "oldPassword": "WrongPassword123456",
  "newPassword": "AnotherPassword123456"
}

### 8. Test error: oldPassword và newPassword giống nhau
PATCH {{baseUrl}}/users/password
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "oldPassword": "NewPassword123456",
  "newPassword": "NewPassword123456"
}

### 9. Test error: password quá ngắn
PATCH {{baseUrl}}/users/password
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "oldPassword": "NewPassword123456",
  "newPassword": "Short"
}

### 10. Test error: không có authorization
PATCH {{baseUrl}}/users/password
Content-Type: application/json

{
  "oldPassword": "NewPassword123456",
  "newPassword": "AnotherPassword123456"
}

### 11. Update profile - thay đổi fullname
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "fullname": "Updated Full Name"
}

### 12. Update profile - thay đổi email
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "email": "newemail@example.com"
}

### 13. Update profile - thay đổi phone
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "phone": "0987654321"
}

### 14. Update profile - thay đổi description
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "description": "This is my new description"
}

### 15. Update profile - thay đổi nhiều field cùng lúc
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "fullname": "Another Name",
  "email": "other@example.com",
  "phone": "+84912345678",
  "description": "Updated description for profile"
}

### 16. Test error: fullname quá ngắn
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "fullname": "A"
}

### 17. Test error: fullname quá dài
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "fullname": "This is a very long name that exceeds one hundred characters limit and should be rejected by the validation schema"
}

### 18. Test error: email không hợp lệ
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "email": "invalid-email"
}

### 19. Test error: phone không hợp lệ (quá ngắn)
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "phone": "123"
}

### 20. Test error: phone không hợp lệ (ký tự không hợp lệ)
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "phone": "phone123abc"
}

### 21. Test error: description quá dài
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "description": "This is an extremely longThis is an extremely longThis is an extremely longThis is an extremely longThis is an extremely long description that exceeds the maximum allowed length of two hundred characters and therefore should be rejected by the validation"
}

### 22. Test error: không gửi field nào (body rỗng)
PATCH {{baseUrl}}/users/profile
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{}

### 23. Test error: không authenticate
PATCH {{baseUrl}}/users/profile
Content-Type: application/json

{
  "fullname": "Someone"
}

### 24. Get me để verify profile đã được update
GET {{baseUrl}}/users/me
Authorization: Bearer {{login_new.response.body.accessToken}}

### 25. Delete account - thành công
DELETE {{baseUrl}}/users/account
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "password": "NewPassword123456"
}

### 26. Test error: password sai
DELETE {{baseUrl}}/users/account
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{
  "password": "WrongPassword123456"
}

### 27. Test error: không gửi password
DELETE {{baseUrl}}/users/account
Authorization: Bearer {{login_new.response.body.accessToken}}
Content-Type: application/json

{}

### 28. Test error: không authenticate
DELETE {{baseUrl}}/users/account
Content-Type: application/json

{
  "password": "NewPassword123456"
}