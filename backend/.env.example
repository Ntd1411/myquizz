# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=myquizz_db
DB_POOL_MAX=20   
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=12345678
# JWT
JWT_SECRET=12345678
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=12345678
JWT_REFRESH_EXPIRES_IN=7d
SOCKET_JWT_SECRET=12345678
SOCKET_TOKEN_TTL=6h
# CORS
FRONTEND_URL=https://localhost:3000
ALLOW_ORIGIN=http://localhost:3000,http://localhost:5173
# Server
PORT=3000
NODE_ENV=development
# Cloud
SPACES_ACCESS_KEY=xxxxx
SPACES_SECRET_KEY=xxxxx
SPACES_ENDPOINT=sgp1.digitaloceanspaces.com
SPACES_BUCKET=my-images
SPACES_REGION=sgp1
SPACES_PUBLIC_URL=https://my-images.sgp1.digitaloceanspaces.com
# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=12345678
MAIL_FROM=no-reply@myquizz.com
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback