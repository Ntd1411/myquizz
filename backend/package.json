{
  "name": "myquizz",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc && node scripts/copy-sql.mjs",
    "docs:export": "tsx src/docs/export.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts migrate",
    "db:seed": "tsx src/infrastructure/database/migrate.ts seed",
    "db:seed:demo": "tsx src/infrastructure/database/seed.demo.ts",
    "db:score": "tsx src/infrastructure/jobs/scoring.cli.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "trivia:build": "tsx scripts/build-trivia-seed.ts",
    "db:migrate:prod": "node dist/infrastructure/database/migrate.js migrate",
    "db:score:prod": "node dist/infrastructure/jobs/scoring.cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ntd1411/myquizz.git"
  },
