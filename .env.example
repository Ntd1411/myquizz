# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=myquizz_db
DB_POOL_MAX=20   
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=12345678
# JWT
JWT_SECRET=12345678
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=12345678
JWT_REFRESH_EXPIRES_IN=7d
SOCKET_JWT_SECRET=12345678
SOCKET_TOKEN_TTL=6h
# CORS
FRONTEND_URL=http://localhost:3000
ALLOW_ORIGIN=http://localhost:3000,http://localhost:5173
# Server
PORT=3000
NODE_ENV=development
# Public origin of the API including the /v1 prefix, e.g. https://api.example.com/v1.
# Optional: when set it becomes the default server in the /v1/docs reference.
API_PUBLIC_URL=
# Cloud
SPACES_ACCESS_KEY=your_access_key_here
SPACES_SECRET_KEY=your_secret_key_here
SPACES_ENDPOINT=https://endpoint_url_here.com
SPACES_BUCKET=bucket_name_here
SPACES_REGION=region_here
SPACES_PUBLIC_URL=https://space_public_url_here.com
# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=12345678
MAIL_FROM=no-reply@myquizz.com
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback