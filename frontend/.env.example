# Base URL of the backend REST API (no trailing slash).
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Google Identity Services client id. Must be the SAME client id the backend uses
# in GOOGLE_CLIENT_ID, and http://localhost:5173 must be registered as an
# authorized JavaScript origin. Leave empty to disable One Tap and fall back to
# the /auth/google redirect flow.
VITE_GOOGLE_CLIENT_ID=
