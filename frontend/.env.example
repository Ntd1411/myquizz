# Origin of the backend server (used to build the Socket.IO namespace URL).
VITE_API_ORIGIN=http://localhost:3000

# REST base URL. Every endpoint is prefixed with /api/v1.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional: only needed when Google One Tap is enabled.
VITE_GOOGLE_CLIENT_ID=
